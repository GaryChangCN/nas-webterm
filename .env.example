# Replace OWNER with the GitHub repository owner; do not commit your real .env.
WEBTERM_IMAGE=ghcr.io/OWNER/nas-webterm:latest
# Loopback by default. Set to your NAS LAN address for trusted LAN access.
WEB_BIND_IP=127.0.0.1
WEB_PORT=7681
TZ=UTC
TTYD_USER=terminal
# Required; no default password. For complex values use Compose .env quoting rules.
TTYD_PASS=
